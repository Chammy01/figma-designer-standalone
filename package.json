{
  "name": "figma-designer-standalone",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test scripts/figma-browser-contract.test.mjs scripts/figma-browser-freshness.test.mjs scripts/figma-critique.test.mjs",
    "test:hardening": "bun test scripts/figma-hardening.test.ts scripts/figma-variants.test.ts",
    "test:source": "bun test scripts/figma-live-source.test.ts",
    "test:browser": "node --test scripts/figma-browser-integration.test.mjs",
    "test:opencode": "node --test scripts/figma-opencode-timeouts.test.mjs",
    "figma:browser-test": "node scripts/figma-browser-test.mjs",
    "figma:browser-status": "node scripts/figma-browser-status.mjs",
    "figma:browser-source": "node scripts/figma-browser-source.mjs",
    "figma:install-browser": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0"
  }
}
